#!/usr/bin/env bash
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
ROOT="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
cd "$ROOT"

APP_NAME="Paper Radar"
HOST="${PAPER_RADAR_HOST:-0.0.0.0}"
PORT="${PAPER_RADAR_PORT:-8090}"
URL="http://localhost:${PORT}"
PID_FILE="logs/paper-radar.pid"
LOG_FILE="logs/web.log"
VENV=".venv"
REQ_HASH_FILE="${VENV}/.requirements.sha256"

usage() {
  cat <<EOF
${APP_NAME}

Usage:
  ./paper-radar              Start in background and open ${URL}
  ./paper-radar start        Start in background
  ./paper-radar stop         Stop the background server
  ./paper-radar restart      Restart the server
  ./paper-radar status       Show server status
  ./paper-radar logs         Follow web logs
  ./paper-radar foreground   Run in the current terminal for debugging

Environment:
  PAPER_RADAR_PORT=8090      Override port
  PAPER_RADAR_HOST=0.0.0.0   Override host
  PAPER_RADAR_OPEN=0         Do not open browser after start
EOF
}

ensure_dirs() {
  mkdir -p data output logs
}

ensure_env() {
  if [ ! -f .env ] && [ -f .env.example ]; then
    cp .env.example .env
    echo "Created .env from .env.example. Edit .env later if you need AI/Zotero features."
  fi
}

requirements_hash() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum requirements.txt | awk '{print $1}'
  else
    cksum requirements.txt | awk '{print $1}'
  fi
}

install_python_packages() {
  command -v apt-get >/dev/null 2>&1 || return 1
  echo "Installing Python base packages with apt..."
  if command -v sudo >/dev/null 2>&1; then
    sudo apt-get update
    sudo apt-get install -y python3 python3-venv python3-pip
  else
    apt-get update
    apt-get install -y python3 python3-venv python3-pip
  fi
}

ensure_venv() {
  if ! command -v python3 >/dev/null 2>&1 || ! python3 -c "import venv" >/dev/null 2>&1; then
    install_python_packages || {
      echo "python3 and python3-venv are required."
      echo "On Ubuntu/Debian: sudo apt-get install -y python3 python3-venv python3-pip"
      exit 1
    }
  fi

  if ! command -v python3 >/dev/null 2>&1 || ! python3 -c "import venv" >/dev/null 2>&1; then
    echo "python3 and python3-venv are required."
    exit 1
  fi

  if [ ! -x "${VENV}/bin/python" ]; then
    python3 -m venv "$VENV"
  fi

  local current_hash installed_hash deps_ready
  current_hash="$(requirements_hash)"
  installed_hash="$(cat "$REQ_HASH_FILE" 2>/dev/null || true)"
  if "${VENV}/bin/python" -c "import fastapi, uvicorn" >/dev/null 2>&1; then
    deps_ready=1
  else
    deps_ready=0
  fi

  if [ "$deps_ready" -eq 1 ] && [ -z "$installed_hash" ]; then
    printf "%s\n" "$current_hash" > "$REQ_HASH_FILE"
    return 0
  fi

  if [ "$current_hash" != "$installed_hash" ] || [ "$deps_ready" -eq 0 ]; then
    "${VENV}/bin/python" -m pip install -r requirements.txt
    printf "%s\n" "$current_hash" > "$REQ_HASH_FILE"
  fi
}

read_pid() {
  [ -f "$PID_FILE" ] && cat "$PID_FILE" || true
}

is_pid_running() {
  local pid="$1"
  [ -n "$pid" ] && kill -0 "$pid" >/dev/null 2>&1
}

managed_pid_running() {
  local pid
  pid="$(read_pid)"
  is_pid_running "$pid"
}

port_is_busy() {
  (echo >/dev/tcp/127.0.0.1/"$PORT") >/dev/null 2>&1
}

open_browser() {
  [ "${PAPER_RADAR_OPEN:-1}" = "0" ] && return 0
  if command -v wslview >/dev/null 2>&1; then
    nohup wslview "$URL" >/dev/null 2>&1 || true
  elif command -v cmd.exe >/dev/null 2>&1; then
    cmd.exe /C start "" "$URL" >/dev/null 2>&1 || true
  elif command -v xdg-open >/dev/null 2>&1; then
    nohup xdg-open "$URL" >/dev/null 2>&1 || true
  fi
}

start_server() {
  ensure_dirs
  ensure_env
  ensure_venv

  if managed_pid_running; then
    echo "${APP_NAME} is already running: ${URL}"
    open_browser
    return 0
  fi

  if port_is_busy; then
    echo "Port ${PORT} is already in use."
    echo "Run './paper-radar stop' if it is an old ${APP_NAME} process, or set PAPER_RADAR_PORT=8091."
    exit 1
  fi

  "${VENV}/bin/python" tools/health_check.py
  nohup "${VENV}/bin/python" -m uvicorn src.web:app --host "$HOST" --port "$PORT" >"$LOG_FILE" 2>&1 &
  local pid=$!
  printf "%s\n" "$pid" > "$PID_FILE"
  sleep 2

  if ! is_pid_running "$pid"; then
    echo "${APP_NAME} failed to start. Recent log:"
    tail -n 80 "$LOG_FILE" 2>/dev/null || true
    exit 1
  fi

  echo "${APP_NAME} is running: ${URL}"
  echo "Stop it with: ./paper-radar stop"
  open_browser
}

stop_server() {
  local pid stopped=0
  pid="$(read_pid)"
  if is_pid_running "$pid"; then
    kill "$pid" >/dev/null 2>&1 || true
    stopped=1
    for _ in 1 2 3 4 5; do
      is_pid_running "$pid" || break
      sleep 1
    done
    if is_pid_running "$pid"; then
      kill -9 "$pid" >/dev/null 2>&1 || true
    fi
  fi

  if command -v pgrep >/dev/null 2>&1; then
    while IFS= read -r pid; do
      [ -n "$pid" ] || continue
      [ "$pid" = "$$" ] && continue
      kill "$pid" >/dev/null 2>&1 || true
      stopped=1
    done < <(pgrep -f "uvicorn src.web:app .*--port ${PORT}" || true)
  fi

  rm -f "$PID_FILE"
  if [ "$stopped" -eq 1 ]; then
    echo "${APP_NAME} stopped."
  else
    echo "${APP_NAME} was not running."
  fi
}

status_server() {
  local pid
  pid="$(read_pid)"
  if is_pid_running "$pid"; then
    echo "${APP_NAME} is running on ${URL} (pid ${pid})."
  elif port_is_busy; then
    echo "Port ${PORT} is in use, but not by this managed ${APP_NAME} pid file."
  else
    echo "${APP_NAME} is stopped."
  fi
}

foreground_server() {
  ensure_dirs
  ensure_env
  ensure_venv
  "${VENV}/bin/python" tools/health_check.py
  exec "${VENV}/bin/python" -m uvicorn src.web:app --host "$HOST" --port "$PORT" --reload
}

case "${1:-start}" in
  start|up)
    start_server
    ;;
  stop|down)
    stop_server
    ;;
  restart)
    stop_server
    start_server
    ;;
  status)
    status_server
    ;;
  logs)
    ensure_dirs
    touch "$LOG_FILE"
    tail -n 80 -f "$LOG_FILE"
    ;;
  foreground|fg)
    foreground_server
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    usage
    exit 1
    ;;
esac
